  "dependencies": {
    "@emotion/native": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "date-fns": "~4.4.0",
    "postcss": "^8.5.26",
    "react-icons": "5.7.0",
    "react-native-vector-icons": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.19.0",
    "@lerna-lite/cli": "^5.4.2",
    "@lerna-lite/publish": "^5.4.2",
    "@lerna-lite/version": "^5.4.2",
    "@react-types/datepicker": "3.14.0",
    "@react-types/shared": "3.36.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.18",
    "@types/react-native-vector-icons": "^6.4.16",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-storybook": "catalog:",
    "expo": "^57.0.11",
    "globals": "^15.14.0",
    "husky": "^9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-web": "^0.21.2",
    "rimraf": "^5.0.5",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "storybook": "catalog:",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "dev": "pnpm --filter '@tecsinapse/*' run '/^dev:.*/'",
    "dev:cortex": "pnpm --filter '@tecsinapse/cortex-*' run '/^dev:.*/'",
    "build": "pnpm --filter '@tecsinapse/*' run '/^build:.*/'",
    "storybook": "cross-env STORYBOOK_FONT_URL='' storybook dev -p 7007",
    "build:storybook": "rimraf -rf sbdocs/ && cross-env STORYBOOK_FONT_URL='/design-system' storybook build -o sbdocs/",
    "rm:dts": "rimraf -rf packages/*/dist/*.d.ts",
    "rm:dist": "rimraf -rf packages/*/dist/",
    "lint:ts": "eslint 'packages/**/*.ts{,x}'",
    "lint": "pnpm lint:fix:quiet",
    "lint:fix": "pnpm lint:ts --fix-dry-run",
    "lint:fix:quiet": "pnpm lint:ts --fix --quiet",
    "prepare": "husky && pnpm build",
    "test": "pnpm --filter '@tecsinapse/*' run test",
    "build:core": "cd packages/cortex-core && pnpm build:es && pnpm build:dts && cd ../.."
  },
  "engines": {
    "node": "22"
  },
  "lint-staged": {
    ".{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    ".{json,mdx,md}": "prettier --write"
  },
  "packageManager": "pnpm@11.17.0"
}
