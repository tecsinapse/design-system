{
  "name": "@tecsinapse/design-system",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@emotion/native": "~11.11.0",
    "@emotion/react": "~11.11.0",
    "@emotion/styled": "~11.11.0",
    "@tailwindcss/postcss": "~4.3.3",
    "date-fns": "~4.4.0",
    "postcss": "^8.5.23",
    "react-icons": "5.5.0",
    "react-native-vector-icons": "^9.2.0",
    "tailwindcss": "~4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@lerna-lite/cli": "^5.4.2",
    "@lerna-lite/publish": "^5.4.2",
    "@lerna-lite/version": "^5.4.2",
    "@react-types/datepicker": "3.11.0",
    "@react-types/shared": "3.28.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.2",
    "@types/react-native-vector-icons": "^6.4.16",
    "@types/react-transition-group": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.4",
    "globals": "^15.14.0",
    "husky": "^9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.74.1",
    "react-native-web": "^0.21.2",
    "rimraf": "^5.0.5",
    "rollup": "^4.62.3",
    "rollup-plugin-esbuild": "^6.1.1",
    "storybook": "10.5.4",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^8.1.5",
    "eslint-plugin-storybook": "10.5.4"
  },
  "scripts": {
    "dev": "pnpm --filter '@tecsinapse/*' run '/^dev:.*/'",
    "dev:cortex": "pnpm --filter '@tecsinapse/cortex-*' run '/^dev:.*/'",
    "build": "pnpm --filter '@tecsinapse/*' run '/^build:.*/'",
    "storybook": "cross-env STORYBOOK_FONT_URL='' storybook dev -p 7007",
    "build:storybook": "rimraf -rf sbdocs/ && cross-env STORYBOOK_FONT_URL='/design-system' storybook build -o sbdocs/",
    "rm:dts": "rimraf -rf packages/*/dist/*.d.ts",
    "rm:dist": "rimraf -rf packages/*/dist/",
    "lint:ts": "eslint 'packages/**/*.ts{,x}'",
    "lint": "pnpm lint:fix:quiet",
    "lint:fix": "pnpm lint:ts --fix-dry-run",
    "lint:fix:quiet": "pnpm lint:ts --fix --quiet",
    "prepare": "husky && pnpm build",
    "test": "pnpm --filter '@tecsinapse/*' run test",
    "build:core": "cd packages/cortex-core && pnpm build:es && pnpm build:dts && cd ../.."
  },
  "engines": {
    "node": "22"
  },
  "lint-staged": {
    ".{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    ".{json,mdx,md}": "prettier --write"
  },
  "packageManager": "pnpm@11.17.0"
}
