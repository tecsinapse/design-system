{
  "name": "@tecsinapse/cortex-core",
  "version": "2.1.2",
  "license": "MIT",
  "description": "Core library for tailwindcss based design",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": "./dist/esm/index.js",
    "./default.css": "./dist/default.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens-native.css": "./dist/tokens-native.css",
    "./types": "./dist/types/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev:es": "rolldown --config --watch",
    "dev:dts": "tsc --project tsconfig.build.json --watch",
    "build:es": "rimraf dist && rolldown --config",
    "build:dts": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "clsx": "catalog:",
    "currency.js": "catalog:",
    "polished": "^4.3.1",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "rollup-plugin-copy": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "directory": "packages/cortex-core",
    "url": "git+ssh://git@github.com/tecsinapse/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/tecsinapse/design-system/issues"
  },
  "homepage": "https://tecsinapse.github.io/design-system/",
  "peerDependencies": {
    "tailwindcss": "catalog:"
  }
}
