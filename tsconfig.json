{
  "compilerOptions": {
    "noImplicitAny": false,
    "baseUrl": ".",
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["react", "jest"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "removeComments": true,
    "preserveSymlinks": true,
    "paths": {
      "@tecsinapse/*": ["packages/*/src"]
    }
  },
  "exclude": ["node_modules", "**/dist/**/*", "**/*.stories.*"],
  "typeRoots": ["./node_modules/@types"]
}
